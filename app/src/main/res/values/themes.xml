<resources>
    <!-- Тема самого приложения -->
    <style name="Theme.ARRoom" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>

    <!-- Стартовая тема. Инициализация Filament и ARCore занимает заметное
         время: без сплэша пользователь секунду-две смотрит в чёрный экран
         и думает, что приложение не запустилось. -->
    <style name="Theme.ARRoom.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ARRoom</item>
    </style>
</resources>
